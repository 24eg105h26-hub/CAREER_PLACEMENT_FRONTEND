# ==============================================================================
# SMARTPLACEMENT FRONTEND CONFIGURATION (.env.example)
# Note: VITE_ variables are embedded at BUILD time into JavaScript bundles.
# If you change these variables in production, you MUST run 'npm run build' again.
# Never place backend API keys or secrets in frontend environment files!
# ==============================================================================

# API Base URL:
# - For local development using Vite proxy: /api
# - For production using same domain / reverse proxy: /api
# - For production using standalone API domain: https://api.yourdomain.com/api
VITE_API_BASE_URL=/api

# Local dev proxy target (only utilized by 'npm run dev' to proxy /api requests to Spring Boot)
VITE_BACKEND_URL=http://localhost:8080

# Application Public Name
VITE_APP_NAME=SmartPlacement AI
